---
interface Props {
  value: string;
  label?: string;
}
const { value, label = value } = Astro.props;
---

<cp-swatch value={value}>
  <button
    type="button"
    class="cp-swatch"
    aria-label={label}
    style={{ background: value }}
  ></button>
</cp-swatch>
<script>
  import './client';
</script>
