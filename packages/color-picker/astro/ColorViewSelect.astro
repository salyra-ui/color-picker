---
import { colorViews } from '../core';
interface Props {
  label?: string;
}
---

<cp-view-select>
  <label class="cp-format">
    {Astro.props.label ?? 'Picker view'}
    <select>
      {colorViews.map((view) => (
        <option value={view}>{view === 'area' ? 'Rectangle' : 'Wheel'}</option>
      ))}
    </select>
  </label>
</cp-view-select>
<script>
  import './client';
</script>
