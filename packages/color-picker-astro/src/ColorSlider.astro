---
import {
  sliderLabels,
  type SliderChannel,
  type ColorPartClasses,
} from '@sebytza23/color-picker';
interface Props {
  channel?: SliderChannel;
  label?: string;
  value?: number;
  class?: string;
  classes?: ColorPartClasses;
}
const {
  channel = 'h',
  label = sliderLabels[channel],
  value = channel === 'alpha' ? 100 : 0,
  class: className = '',
  classes = {},
} = Astro.props;
---

<cp-slider channel={channel}>
  <label
    class:list={['cp-slider', className, classes.root, classes.label]}
    data-cp-part="slider"
    data-channel={channel}
  >
    {label}
    <input
      data-cp-part="track"
      class:list={[classes.track, classes.input]}
      type="range"
      min="0"
      max={channel === 'h' ? 359 : 100}
      step="1"
      value={value}
    />
  </label>
</cp-slider>
<script>
  import './client';
</script>
