---
import ColorArea from './ColorArea.astro';
import ColorWheel from './ColorWheel.astro';
import ColorSlider from './ColorSlider.astro';
import { hexToHsv, type ColorView } from '@sebytza23/color-picker';
interface Props {
  value?: string;
  view?: ColorView;
}
const { value = '#6366F1', view = 'area' } = Astro.props,
  c = hexToHsv(value);
---

<cp-surface>
  <div data-view="area" hidden={view !== 'area'}>
    <ColorArea {value} />
    <ColorSlider value={c.h} />
  </div>
  <div data-view="wheel" hidden={view !== 'wheel'}>
    <ColorWheel {value} />
    <ColorSlider channel="v" value={c.v} />
  </div>
</cp-surface>
<script>
  import './client';
</script>
